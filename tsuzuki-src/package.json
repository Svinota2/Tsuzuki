{
  "name": "tsuzuki",
  "productName": "Tsuzuki",
  "version": "1.6.4",
  "description": "Каталог и трекер аниме: Shikimori, онлайн-просмотр Kodik, свои файлы, блокировка рекламы",
  "main": "src/main/main.js",
  "author": {
    "name": "Dmitrij Kofanov",
    "email": "tsuzuki@localhost"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "release": "node tools/make-release.mjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.tsuzuki.app",
    "productName": "Tsuzuki",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Каталог и трекер аниме",
      "maintainer": "Dmitrij Kofanov",
      "artifactName": "Tsuzuki-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tsuzuki-Setup-${version}.exe",
      "createDesktopShortcut": true,
      "shortcutName": "Tsuzuki"
    },
    "publish": null
  },
  "homepage": "http://localhost/tsuzuki"
}